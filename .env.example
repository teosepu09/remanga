# =========================================================
# CONFIGURACIÓN DE PRODUCCIÓN
# =========================================================

# URL del API (en local: http://127.0.0.1:5000)
# En producción: https://tu-api.com o https://tu-app.herokuapp.com
API_URL=http://127.0.0.1:5000

# Base de datos Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_anon_key_de_supabase

# Bucket de imágenes en Supabase Storage
SUPABASE_BUCKET=imagenes-mangas

# Entorno (development, production, testing)
ENVIRONMENT=development

# Puerto del servidor Flask
FLASK_PORT=5000
FLASK_ENV=development
